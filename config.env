# Where the files of the CSR will be stored.
export CA_HOME="$CA_ROOT/dev-ca"

# Used to encrypt the intermediate CA private key. Is needed to issue the
# intermediate CA cert. To be more secure, don't define this here - use
# --interactive mode for commands that require the pass phrase.
export CA_INT_PASS="secret"

# Used to encrypt the root CA private key. Needed to generate the root CA
# when x509-ca is run, and to issue the intermediate CA cert in x509-ca.
# To be more secure, don't define this here - use --interactive mode for
# commands that require the pass phrase.
export CA_ROOT_PASS="supersecret"

# Mandatory - will appear in URLs in a few x509 extensions like
# the revokation list URL.
export CA_DOMAIN="mouse.inc"

# The default curve to use when generating elliptic curve keys
export X509_DEFAULT_CURVE="secp384r1"

# Org details. Unset any you don't want to use, except
# SUBJ_ORGANIZATION, which is mandatory
unset SUBJ_COUNTRY
unset SUBJ_EMAIL
export SUBJ_LOCALITY="Floating in space"
export SUBJ_ORGANIZATION="Mouse Inc."
unset SUBJ_ORGANIZATION_UNIT
unset SUBJ_STATE
