# Note: there are POD document tags at the end of this file.

PROG_NAME='Create a Certificate Authority'
PROG_AUTHOR='Mouse <mousefad@googlemail.com>'
PROG_COPYRIGHT='Copyright (C) 2025 Mouse'
PROG_VERSION='1.0'

CURVE=""
RSA_BITS=""
INTERACTIVE=n

main() {
  local getopt_tmp
  getopt_tmp=$(getopt -o c:D:hir:V --long curve:,debug:,help,interactive,rsa:,version -- "$@") || erex "Invalid usage. Try '${0##*/} -h | less -r' for help"
  eval set -- "$getopt_tmp"
  while true; do
    case "$1" in
    --curve | -c)
      CURVE="$2"
      shift 2
      ;;
    --debug | -D)
      DEBUG_LEVEL="$2"
      shift 2
      ;;
    --help | -h)
      usage 0
      return 0
      ;;
    --interactive | -i)
      INTERACTIVE=y
      shift
      ;;
    --rsa | -r)
      RSA_BITS="$2"
      shift 2
      ;;
    --version | -V)
      show_version
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *) erex "unknown option: $1" ;; esac
  done

  if [ $# -gt 1 ]; then
    usage 1
  elif [ $# -eq 1 ]; then
    export CA_HOME="$(realpath "$1")" || exit 1
  fi

  if [ -z "$CURVE" ] && [ -z "$RSA_BITS" ]; then
    CURVE="$X509_DEFAULT_CURVE"
  elif [ -n "$CURVE" ] && [ -n "$RSA_BITS" ]; then
    erex "cannot specify both --curve and --rsa key types"
  fi

  if [ -n "$CURVE" ]; then
    validate_curve
  else
    validate_rsa_bits
  fi

  if [ "$INTERACTIVE" = y ]; then
    prompt_subj
    [ -z "$CA_ROOT_PASS" ] && prompt_pass CA_ROOT_PASS "Passphrase for ROOT CA key"
    [ -z "$CA_INT_PASS" ] && prompt_pass CA_INT_PASS "Passphrase for INTERMEDIATE CA key"
  fi

  local ok=y
  if [ -z "$CA_ROOT_PASS" ]; then
    db -2 "CA_ROOT_PASS env var must be set (or use --interactive option)"
    ok=n
  fi
  if [ -z "$CA_INT_PASS" ]; then

    db -2 "CA_INT_PASS env var must be set (or use --interactive option)"
    ok=n
  fi
  if [ -z "$SUBJ_ORGANIZATION" ]; then
    db -2 "SUBJ_ORGANIZATION env var must be set (or use --interactive option)"
    ok=n
  fi
  [ "$ok" = n ] && exit 1

  create_ca "$@"
}

create_ca() {
  CA_ROOT_HOME="$CA_HOME/root"
  CA_INT_HOME="$CA_HOME/int"

  if [ -e "$CA_HOME" ]; then
    echo "$CA_HOME already exists, ABORTING" 1>&2
    return 1
  else
    db 0 "creating $CA_HOME"
  fi

  mk_temp log

  # Create root CA dir
  mkdir -p "$CA_ROOT_HOME" || return 1
  cd "$CA_ROOT_HOME" || return 1
  mkdir -p certs crl newcerts private || return 1
  chmod 700 private || return 1
  touch index.txt || return 1
  echo 1000 >serial || return 1
  CA_SECTION=CA_root
  template_ca_config_file >openssl.cnf || return 1

  # Create root key
  db 0 "generating root CA key..."
  if [ -n "$CURVE" ]; then
    cmd=(openssl genpkey)
    cmd+=(-algorithm ec)
    cmd+=(-pkeyopt "ec_paramgen_curve:$CURVE")
    cmd+=(-pkeyopt "ec_param_enc:named_curve")
    cmd+=(-out "private/ca.key.pem")
    cmd+=(-pass "env:CA_ROOT_PASS")
    cmd+=(-aes256)
  else
    cmd=(openssl genrsa)
    cmd+=(-aes256)
    cmd+=(-passout "env:CA_ROOT_PASS")
    cmd+=(-out private/ca.key.pem)
    cmd+=("$RSA_BITS")
  fi
  db 2 "exec: $(printf "%q " "${cmd[@]}")"
  if ! "${cmd[@]}" >"$log" 2>&1; then
    dbcat -2 "while generating root key:" <"$log"
    exit 1
  fi
  chmod 400 private/ca.key.pem || exit 1

  db 0 "generating root CA cert..."
  cmd=(openssl req)
  cmd+=(-config openssl.cnf)
  cmd+=(-key private/ca.key.pem)
  cmd+=(-new)
  cmd+=(-x509)
  cmd+=(-days 7300)
  cmd+=(-sha256)
  cmd+=(-extensions v3_ca)
  cmd+=(-passin "env:CA_ROOT_PASS")
  cmd+=(-out certs/ca.cert.pem)
  cmd+=(-subj "$(make_subj_for_cn "ROOT CA")")
  db 2 "exec: $(printf "%q " "${cmd[@]}")"
  if ! "${cmd[@]}" >"$log" 2>&1; then
    dbcat -2 "while creating root cert:" <"$log"
    exit 1
  fi
  chmod 444 certs/ca.cert.pem || exit 1

  # Create intermediate CA dir
  mkdir -p "$CA_INT_HOME" || exit 1
  cd "$CA_INT_HOME" || exit 1
  mkdir -p certs crl csr newcerts private || exit 1
  chmod 700 private || exit 1
  touch index.txt || exit 1
  echo "unique_subject = no" >index.txt.attr || exit 1
  echo 1000 >serial || exit 1
  echo 1000 >"$CA_INT_HOME/crlnumber" || exit 1

  CA_SECTION=CA_int
  template_ca_config_file >openssl.cnf || exit 1

  # make intermediate key
  cd "$CA_ROOT_HOME" || exit 1
  db 0 "generating intermediate CA cert..."
  if [ -n "$CURVE" ]; then
    cmd=(openssl genpkey)
    cmd+=(-algorithm ec)
    cmd+=(-pkeyopt "ec_paramgen_curve:$CURVE")
    cmd+=(-pkeyopt "ec_param_enc:named_curve")
    cmd+=(-out "$CA_INT_HOME/private/intermediate.key.pem")
    cmd+=(-pass "env:CA_INT_PASS")
    cmd+=(-aes256)
  else
    cmd=(openssl genrsa)
    cmd+=(-aes256)
    cmd+=(-passout "env:CA_INT_PASS")
    cmd+=(-out "$CA_INT_HOME/private/intermediate.key.pem")
    cmd+=("$RSA_BITS")
  fi
  db 2 "exec: $(printf "%q " "${cmd[@]}")"
  if ! "${cmd[@]}" >"$log" 2>&1; then
    dbcat -2 "while creating intermediate key:" <"$log"
    exit 1
  fi
  chmod 400 "$CA_INT_HOME/private/intermediate.key.pem" || exit 1

  # create CSR for intermediate certificate (to be signed by root CA)
  db 0 "generating intermediate CA CSR..."
  cmd=(openssl req)
  cmd+=(-config "$CA_INT_HOME/openssl.cnf")
  cmd+=(-new)
  cmd+=(-sha256)
  cmd+=(-key "$CA_INT_HOME/private/intermediate.key.pem")
  cmd+=(-passin "env:CA_INT_PASS")
  cmd+=(-out "$CA_INT_HOME/csr/intermediate.csr.pem")
  cmd+=(-subj "$(make_subj_for_cn "INT CA")")
  db 2 "exec: $(printf "%q " "${cmd[@]}")"
  if ! "${cmd[@]}" >"$log" 2>&1; then
    dbcat -2 "while creating intermediate CSR" <"$log"
    exit 1
  fi

  # create intermediate certificate by processing the CSR with the root CA
  db 0 "generating intermediate CA cert..."
  cmd=(openssl ca)
  cmd+=(-batch)
  cmd+=(-config openssl.cnf)
  cmd+=(-extensions v3_intermediate_ca)
  cmd+=(-days 3650)
  cmd+=(-notext)
  cmd+=(-md sha256)
  cmd+=(-passin "env:CA_ROOT_PASS")
  cmd+=(-in "$CA_INT_HOME/csr/intermediate.csr.pem")
  cmd+=(-out "$CA_INT_HOME/certs/intermediate.cert.pem")
  db 2 "exec: $(printf "%q " "${cmd[@]}")"
  if ! "${cmd[@]}" >"$log" 2>&1; then
    dbcat -2 "while signing intermediate CSR" <"$log"
    exit 1
  fi
  chmod 444 "$CA_INT_HOME/certs/intermediate.cert.pem" || exit 1

  # Make cert chain file
  db 0 "combining certs to form chain of trust..."
  cat "$CA_INT_HOME/certs/intermediate.cert.pem" "$CA_ROOT_HOME/certs/ca.cert.pem" >"$CA_INT_HOME/certs/ca-chain.cert.pem" || exit 1
}

template_ca_config_file() {
  cat <<EOD
# make_ca: OpenSSL configuration file

[ ca ]
# \`man ca\`
default_ca              = $CA_SECTION

[ CA_root ]
dir                     = $CA_ROOT_HOME
private_key             = \$dir/private/ca.key.pem
certificate             = \$dir/certs/ca.cert.pem
crl                     = \$dir/crl/ca.crl.pem
policy                  = policy_root
default_days            = 1836

certs                   = \$dir/certs
crl_dir                 = \$dir/crl
new_certs_dir           = \$dir/newcerts
database                = \$dir/index.txt
serial                  = \$dir/serial
RANDFILE                = \$dir/private/.rand
crlnumber               = \$dir/crlnumber
crl_extensions          = crl_ext
default_crl_days        = 30
name_opt                = ca_default
cert_opt                = ca_default
preserve                = no
default_md              = sha256

[ CA_int ]
dir                     = $CA_INT_HOME
private_key             = \$dir/private/intermediate.key.pem
certificate             = \$dir/certs/intermediate.cert.pem
crl                     = \$dir/crl/intermediate.crl.pem
policy                  = policy_int
default_days            = 375

certs                   = \$dir/certs
crl_dir                 = \$dir/crl
new_certs_dir           = \$dir/newcerts
database                = \$dir/index.txt
serial                  = \$dir/serial
RANDFILE                = \$dir/private/.rand
crlnumber               = \$dir/crlnumber
crl_extensions          = crl_ext
default_crl_days        = 30
name_opt                = ca_default
cert_opt                = ca_default
preserve                = no
default_md              = sha256

[ policy_root ]
# See the POLICY FORMAT section of \`man ca\`.
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = match
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ policy_int ]
# See the POLICY FORMAT section of \`man ca\`.
countryName             = optional
stateOrProvinceName     = optional
localityName            = supplied
organizationName        = match
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
# Options for the \`req\` tool (\`man req\`).
default_bits        = 4096
distinguished_name  = req_distinguished_name
string_mask         = utf8only

# SHA-1 is deprecated, so use SHA-2 instead.
default_md          = sha256

# Extension to add when the -x509 option is used.
x509_extensions     = v3_ca

[ req_distinguished_name ]
# See <https://en.wikipedia.org/wiki/Certificate_signing_request>.
countryName                     = Country Name (2 letter code)
stateOrProvinceName             = State or Province Name
localityName                    = Locality Name
0.organizationName              = Organization Name
organizationalUnitName          = Organizational Unit Name
commonName                      = Common Name
emailAddress                    = Email Address

[ v3_ca ]
# Extensions for a typical CA (\`man x509v3_config\`).
basicConstraints = critical, CA:true, pathlen:5
certificatePolicies = 1.2.3.4
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

[ v3_intermediate_ca ]
# Extensions for a typical intermediate CA (\`man x509v3_config\`).
basicConstraints = critical, CA:true, pathlen:0
certificatePolicies = 1.2.3.4
crlDistributionPoints = crldp_int
keyUsage = critical, keyCertSign, cRLSign
subjectAltName = dirName:san_dir
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[ crldp_int ]
fullname=URI:http://${CA_DOMAIN}/cert/revoke.crl

[san_dir]
CN=CA

[ usr_cert ]
# Extensions for client certificates (\`man x509v3_config\`).
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = critical, nonRepudiation, digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth, emailProtection

[ server_cert ]
# Extensions for server certificates (\`man x509v3_config\`).
subjectAltName = @san_list
basicConstraints = CA:FALSE
crlDistributionPoints = crldp_int
keyUsage = digitalSignature, keyEncipherment
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
certificatePolicies = @cert_policy

extendedKeyUsage = serverAuth, clientAuth

[ san_list ]
DNS = example.${CA_DOMAIN}

[ cert_policy ]
policyIdentifier = 1.2.3.4
CPS = "http://${CA_DOMAIN}/cert/CPS"

[ crl_ext ]
# Extension for CRLs (\`man x509v3_config\`).
authorityKeyIdentifier=keyid:always

[ ocsp ]
# Extension for OCSP signing certificates (\`man ocsp\`).
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, OCSPSigning
EOD
}

source x509-include
main "$@"

# This is one (awful) way to create what is effectively a big comment.
cat >/dev/null <<EOD

__END__

=head1 NAME

x509-ca - Create a CA for issuing certificates

=head1 SYNOPSIS

x509-ca [options] [path]

=head1 DESCRIPTION

Creates a Certificate Authority (CA) at the specified path, or F<$CA_HOME>
if path is not specified. The CA consists of two sub-directories: F<root>
and F<int>, which contain the config, keys, certificates and state files
required for a root authority and an intermediate (issuer) authority.

These files may then be used with the x509-req(1) and x509-sign(1) 
programs to issue server and client certificates.

The password for the root and intermediate authority private keys will be
taben from the B<CA_ROOT_PASS> environment variable, which must be set.

=head1 OPTIONS

=over

=item B<--curve>=I<c> or B<-c> I<c>

Specify which elliptic curve to use. The default is taken from the 
F<X509_DEFAULT_CURVE> environment variable.

To see what curves are available, use the command: 

 openssl ecparam -list_curves>

=item B<--debug>=I<lev> or B<-D> I<lev>

Set debugging level to I<lev>.

=item B<--help> or B<-h>

Print usage information, then exit.

=item B<--interactive> or B<-i>

Prompt user for value(s) of subject fields. Defaults will be taken from
the environment variables described in the ENVIRONMENT section, below.

=item B<--verbose> or B<-V>

Print program name and version, then exit.

=back

=head1 CHANGES

=head2 2020-10-08, Version 1.2 (Ensemble 2040)

=over

=item Fix help output.

=back

=head2 2020-08-21, Version 1.1 (Ensemble 2040)

=over

=item Change x509 extensions to match BT CA G4.

=item Server certs will be issued with client mode also.

=item All server certs will use subjectAltName (like prod).

=back

=head1 ENVIRONMENT

=over

=item CA_HOME

Optional - if set will be used as the default destination directory.
If not set, the user must provide the destination directory as a parameter
when invoking F<x509-ca>.

=item CA_ROOT_PASS

Mandatory value for the password that protects the root CA key.

=item CA_INT_PASS

Mandatory value for the password that protects the intermediate CA key.

=item CA_DOMAIN

Mandatory value for domain wher CRLs and CPS will be advertised.

=item SUBJ_COUNTRY

Optional value for country field in CA certificate subject.

=item SUBJ_EMAIL

Optional value for email field in CA certificate subject.

=item SUBJ_LOCALITY

Optional value for location field in CA certificate subject.

=item SUBJ_ORGANIZATION

Mandatory value for organization field in CA certificate subject.

=item SUBJ_ORGANIZATION_UNIT

Optional value for organization unit field in CA certificate subject.

=item SUBJ_STATE

Optional value for state/province field in CA certificate subject.

=item X509_DEFAULT_CURVE

Optional ID of elliptic curve to use when B<--curve> and B<--rsa>
options are not used.

=back

=head1 COPYRIGHT

Copyright (C) 2025 Mouse. Released under the terms of the GNU GPL
v3 license.

=head1 AUTHORS

Mouse <mousefad@googlemail.com>

=head1 SEE ALSO

x509-req(1), x509-sign(1)

=cut

EOD
