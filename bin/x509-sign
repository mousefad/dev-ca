#!/usr/bin/env bash

PROG_NAME='Sign a CSR with a CA'
PROG_AUTHOR='Mouse'
PROG_COPYRIGHT='Copyright (C) 2025'
PROG_VERSION='1.0'

declare -a SANS=()
CURVE=""
RSA_BITS=""
KEY_PATH=""
CSR_PATH=""
INTERACTIVE=n
DAYS=$((365 + 14))

main() {
    local getopt_tmp
    getopt_tmp=$(getopt -o c:D:d:hV --long ca-dir:,debug:,help,valid-days:,version -- "$@") || erex 1 "Invalid usage. Try '${0##*/} -h | less -r' for help"
    eval set -- "$getopt_tmp"
    while true; do
        case "$1" in
        --ca-dir | -c)
            export CA_HOME="$2"
            shift 2
            ;;
        --debug | -D)
            DEBUG_LEVEL="$2"
            shift 2
            ;;
        --help | -h)
            usage 0
            return 0
            ;;
        --valid-days | -d)
            DAYS="$2"
            shift 2
            ;;
        --version | -V)
            show_version
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            erex 1 "ERROR: unknown option: $1"
            ;;
        esac
    done

    if [ "$#" -lt 1 ]; then
        usage 1
    fi

    CSR_PATH="$1"
    if [ -n "$2" ]; then
        PEM_PATH="$2"
    else
        PEM_PATH="${1%.csr}.pem"
    fi
    if [ -e "$PEM_PATH" ]; then
        erex "Certificate file '$PEM_PATH' already exists; ABORTING"
    fi

    [ -n "CA_INT_PASS" ] || prompt_pass -v CA_INT_PASS "Intermediate CA pass-phrase"

    sign_csr
}

sign_csr() {
    db 0 "Generating certificate '$PEM_PATH' from CSR '$CSR_PATH' ..."
    mk_temp log
    cmd=(openssl ca)
    cmd+=(-batch)
    cmd+=(-config "$CA_HOME/int/openssl.cnf")
    cmd+=(-extensions server_cert)
    cmd+=(-days "$DAYS")
    cmd+=(-notext)
    cmd+=(-md sha256)
    cmd+=(-passin "env:CA_INT_PASS")
    cmd+=(-in "$CSR_PATH")
    cmd+=(-out "$PEM_PATH")
    db 1 "exec: $(printf "%q " "${cmd[@]}")"
    if ! "${cmd[@]}" >"$log" 2>&1; then
        dbcat -2 "while signing certificate:" <"$log"
        exit 1
    fi

    db 0 "Verifying Chain of Trust..."
    cmd=(openssl verify)
    cmd+=(-CAfile "$CA_HOME/int/certs/ca-chain.cert.pem")
    cmd+=("$PEM_PATH")
    db 1 "exec: $(printf "%q " "${cmd[@]}")"
    if ! "${cmd[@]}" >"$log" 2>&1; then
        dbcat -2 "while verifying chain of trust:" <"$log"
        exit 1
    fi
}

source x509-include
main "$@"

cat <<EOD >/dev/null

=head1 NAME

x509-sign - Sign a CSR with a CA

=head1 SYNOPSIS

x509-sign [options] path.csr [path.pem]

=head1 DESCRIPTION

Use a CA defined in the directory F<$CA_HOME> to sign a specified CSR.  Put the
signed certificate in a file with the same name as the csr, but with the F<.csr>
extension removed, and F<.pem> appended.

Is a second parameter is used, it will be used as the output path.

The CA private key password is read from the environment variable CA_PASS

=head1 OPTIONS

=over

=item B<--ca-dir>=I<path> or B<-c> I<path>

Specify the path of the CA files. Thhis over-rides the value of the F<CA_PATH>
environment variable.

=item B<--debug>=I<lev> or B<-D> I<lev>

Set debugging level to I<lev>.

=item B<--help> or B<-h>

Print usage information, then exit.

=item B<--valid-days>=I<n> or B<-d> I<n>

Set the number of days the certificate is valid for in days (default is one
year plus a two week grace period).

=item B<--version> or B<-V>

Print program name and version, then exit.

=back

=head1 ENVIRONMENT

=over

=item SUBJ_COUNTRY

Optional value for country field in the CSR.

=item SUBJ_EMAIL

Optional value for email field in the CSR.

=item SUBJ_LOCALITY

Optional value for location field in the CSR.

=item SUBJ_ORGANIZATION

Mandatory value for organization field in the CSR.

=item SUBJ_ORGANIZATION_UNIT

Optional value for organization unit field in the CSR.

=item SUBJ_STATE

Optional value for state/province field in the CSR.

=item X509_DEFAULT_CURVE

Optional ID of elliptic curve to use when B<--curve> and B<--rsa>
options are not used.

=back

=head1 COPYRIGHT

Copyright (C) 2025 Mouse. Released under the terms of the GNU GPL
v3 license.

=head1 AUTHORS

Mouse <mousefad@googlemail.com>

=head1 SEE ALSO

x509-ca(1), x509-sign(1)

=cut

EOD
